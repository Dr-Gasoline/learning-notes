    <tool lib="1" name="Controlled Buffer"/>
  </toolbar>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <wire from="(330,200)" to="(330,220)"/>
    <wire from="(260,190)" to="(260,220)"/>
    <wire from="(140,190)" to="(180,190)"/>
    <wire from="(140,270)" to="(180,270)"/>
    <wire from="(140,230)" to="(180,230)"/>
    <wire from="(340,190)" to="(380,190)"/>
    <wire from="(220,190)" to="(250,190)"/>
    <wire from="(220,190)" to="(220,230)"/>
    <wire from="(220,230)" to="(220,270)"/>
    <wire from="(200,230)" to="(220,230)"/>
    <wire from="(200,190)" to="(220,190)"/>
    <wire from="(200,270)" to="(220,270)"/>
    <wire from="(310,190)" to="(320,190)"/>
    <wire from="(250,190)" to="(260,190)"/>
    <wire from="(260,220)" to="(330,220)"/>
    <comp lib="6" loc="(40,870)" name="Text">
      <a name="text" val="真值表：A B = 00 → Y=0；01 → Y=1；10 → Y=1；11 → Y=1。"/>
      <a name="font" val="SansSerif plain 16"/>
      <a name="halign" val="left"/>
      <a name="valign" val="top"/>
    </comp>
    <comp lib="6" loc="(260,805)" name="Text">
      <a name="text" val="下面的三角形有使能端；上面的普通 Buffer 没有使能端，但修改了输出方式。"/>
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="valign" val="top"/>
    </comp>
    <comp lib="6" loc="(40,905)" name="Text">
      <a name="text" val="实验：删除第二路或第三路的下拉，把 A、B 都设成 0，该路输出会浮空；普通 OR 仍为 0。"/>
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="valign" val="top"/>
    </comp>
    <comp lib="0" loc="(380,190)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(140,190)" name="Pin"/>
    <comp lib="6" loc="(40,935)" name="Text">
      <a name="text" val="所有并线的驱动器只输出 1 或 Z，因此没有“一个输出 0、另一个输出 1”的冲突。"/>
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="valign" val="top"/>
    </comp>
    <comp lib="1" loc="(340,190)" name="Controlled Buffer"/>
    <comp lib="0" loc="(310,190)" name="Constant"/>
    <comp lib="1" loc="(200,270)" name="Buffer">
      <a name="out" val="Z1"/>
    </comp>
    <comp lib="6" loc="(40,965)" name="Text">
      <a name="text" val="这里只演示组合逻辑，不需要时钟。下拉是默认电平，并非用来延迟信号。"/>
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="valign" val="top"/>
    </comp>
    <comp lib="0" loc="(250,190)" name="Pull Resistor"/>
    <comp lib="1" loc="(200,190)" name="Buffer">
      <a name="out" val="Z1"/>
    </comp>
    <comp lib="0" loc="(140,230)" name="Pin"/>
    <comp lib="0" loc="(140,270)" name="Pin"/>
    <comp lib="1" loc="(200,230)" name="Buffer">
      <a name="out" val="Z1"/>
    </comp>
  </circuit>
